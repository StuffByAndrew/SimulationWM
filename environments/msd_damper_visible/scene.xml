    <spatial name="coil_1" width=".003" rgba=".78 .79 .82 1"><site site="coil_wall_1"/><geom geom="coil_core"/><site site="coil_block_1"/></spatial>
    <spatial name="coil_2" width=".003" rgba=".78 .79 .82 1"><site site="coil_wall_2"/><geom geom="coil_core"/><site site="coil_block_2"/></spatial>
    <spatial name="coil_3" width=".003" rgba=".78 .79 .82 1"><site site="coil_wall_3"/><geom geom="coil_core"/><site site="coil_block_3"/></spatial>
    <spatial name="coil_4" width=".003" rgba=".78 .79 .82 1"><site site="coil_wall_4"/><geom geom="coil_core"/><site site="coil_block_4"/></spatial>
    <spatial name="coil_5" width=".003" rgba=".78 .79 .82 1"><site site="coil_wall_5"/><geom geom="coil_core"/><site site="coil_block_5"/></spatial>
