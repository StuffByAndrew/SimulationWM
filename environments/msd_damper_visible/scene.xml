<mujoco model="msd_damper_visible">
  <!-- Researcher-only. 1D mass-spring-damper level "msd_damper_visible": a 0.5 kg block on one frictionless slide joint (x),
       ideal linear spring k = 32 N/m, viscous damper b = 0.8 N s/m (zeta = 0.10), natural period
       0.785 s, travel +-0.14 m. The block has no contacts. Looks: a wall, a rail, a visual-only coil spring and a dashpot (visual piston rod). -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <visual><map znear="0.01" zfar="12"/></visual>
  <worldbody>
    <light name="key" directional="true" pos="-2 -3 4" dir="1 1 -2" diffuse=".85 .82 .76"/>
    <light name="fill" directional="true" pos="2 1 3" dir="-1 -1 -2" diffuse=".3 .36 .45" castshadow="false"/>
    <camera name="fixed" pos="0.36 -0.66 0.86" xyaxes="0.843661488 0.536875492 -0.000000000 -0.253950786 0.399065521 0.881053749" fovy="45"/>
    <geom name="ground" type="plane" size="3 3 .1" rgba=".70 .72 .73 1"/>
    <geom name="table" type="box" pos="-0.075 0 0.375" size="0.375 0.25 0.025" rgba=".65 .52 .37 1"/>
    <geom name="wall" type="box" pos="-0.31 0 0.455" size="0.01 0.07 0.055" rgba=".45 .47 .52 1"/>
    <geom name="rail" type="box" pos="-0.05 0 0.415" size="0.25 0.02 0.015" rgba=".62 .64 .68 1"/>
    <geom name="end_stop" type="box" pos="0.19 0 0.4425" size="0.01 0.03 0.0125" rgba=".22 .24 .28 1"/>
    <geom name="coil_core" type="cylinder" fromto="-0.3 -0.02 0.46 -0.18 -0.02 0.46" size="0.018" contype="0" conaffinity="0" group="3" rgba="0 0 0 0"/>
    <site name="coil_wall_0" pos="-0.298 0 0.46" size=".002" group="3"/>
    <site name="coil_wall_1" pos="-0.298 -0.01 0.47732" size=".002" group="3"/>
    <site name="coil_wall_2" pos="-0.298 -0.03 0.47732" size=".002" group="3"/>
    <site name="coil_wall_3" pos="-0.298 -0.04 0.46" size=".002" group="3"/>
    <site name="coil_wall_4" pos="-0.298 -0.03 0.44268" size=".002" group="3"/>
    <site name="coil_wall_5" pos="-0.298 -0.01 0.44268" size=".002" group="3"/>
    <geom name="dashpot" type="cylinder" fromto="-0.3 0.025 0.46 -0.2 0.025 0.46" size="0.013" rgba=".12 .12 .14 1"/>
    <site name="piston" pos="-0.28 0.025 0.46" size=".002" group="3"/>
    <body name="block" pos="0 0 0.46">
      <joint name="slide" type="slide" axis="1 0 0" range="-0.14 0.14" stiffness="32" springref="0" damping="0.8"/>
      <geom name="block" type="box" size="0.04 0.05 0.03" mass="0.5" contype="0" conaffinity="0" rgba=".85 .32 .14 1"/>
      <site name="coil_block_0" pos="-0.042 -0.039696 0.003473" size=".002" group="3"/>
      <site name="coil_block_1" pos="-0.042 -0.032856 -0.015321" size=".002" group="3"/>
      <site name="coil_block_2" pos="-0.042 -0.01316 -0.018794" size=".002" group="3"/>
      <site name="coil_block_3" pos="-0.042 -0.00030384 -0.003473" size=".002" group="3"/>
      <site name="coil_block_4" pos="-0.042 -0.0071442 0.015321" size=".002" group="3"/>
      <site name="coil_block_5" pos="-0.042 -0.02684 0.018794" size=".002" group="3"/>
      <site name="rod_end" pos="-0.042 0.025 0" size=".002" group="3"/>
