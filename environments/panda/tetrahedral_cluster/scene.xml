    <map znear="0.01" zfar="12" />
  </visual>
  <default>
    <geom friction=".7 .01 .001" condim="3" />
  </default>
  <worldbody>
    <light name="key" directional="true" pos="-2 -3 4" dir="1 1 -2" diffuse=".85 .82 .76" />
