      <freejoint name="cluster_free" />
      <geom name="sphere_1kg" type="sphere" pos="0.000000000 -0.173205081 0.000000000" size=".16" mass="1" rgba=".86 .23 .16 1" />
      <geom name="sphere_2kg" type="sphere" pos="-0.150000000 0.086602540 0.000000000" size=".16" mass="2" rgba=".17 .49 .72 1" />
      <geom name="sphere_4kg" type="sphere" pos="0.150000000 0.086602540 0.000000000" size=".16" mass="4" rgba=".93 .65 .15 1" />
      <geom name="sphere_8kg" type="sphere" pos="0.000000000 0.000000000 0.244948974" size=".16" mass="8" rgba=".24 .65 .40 1" />
    </body>
    <geom name="table" type="box" pos="0 0 .35" size=".75 .75 .05" rgba=".65 .52 .37 1" />
    <geom name="panda_pedestal" type="box" pos="0 -.65 .2" size=".13 .13 .2" rgba=".25 .28 .32 1" />
  </worldbody>
  <include file="../robot/panda.xml" />
</mujoco>