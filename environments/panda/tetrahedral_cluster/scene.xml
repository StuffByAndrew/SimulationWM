    <camera name="fixed" pos="1.350000000 -1.850000000 0.950000000" xyaxes="0.801067978 0.598573383 0.000000000 -0.168705900 0.225778323 0.959459467" fovy="50" />
    <geom name="ground" type="plane" size="3 3 .1" rgba=".70 .72 .73 1" />
    <!-- Cluster moved +0.2 m in y (2026-11-03) so the Panda home-pose hand/fingers clear the top sphere at reset. -->
